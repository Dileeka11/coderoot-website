# Copy to .env on the server. Never commit the real file.
APP_NAME="CodeRoot Solutions"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.coderootsolutions.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=coderoot
DB_USERNAME=coderoot_app
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=database

# The quote and contact forms send email through this. Use the hosting's SMTP details for info@coderootsolutions.com.
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=
MAIL_PORT=465
MAIL_USERNAME=info@coderootsolutions.com
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="info@coderootsolutions.com"
MAIL_FROM_NAME="${APP_NAME}"
MAIL_ENQUIRIES_TO=info@coderootsolutions.com

FRONTEND_URL=https://coderootsolutions.com
FRONTEND_REVALIDATE_SECRET=

# Pick something other than "admin"
ADMIN_PATH=
ADMIN_EMAIL=info@coderootsolutions.com
ADMIN_PASSWORD=

TRUSTED_PROXIES=
